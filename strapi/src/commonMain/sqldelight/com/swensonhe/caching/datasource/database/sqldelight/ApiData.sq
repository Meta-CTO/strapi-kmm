-- CREATE TABLE listData (
--     apiUrl TEXT NOT NULL PRIMARY KEY ON CONFLICT REPLACE,
--     modelVersion INTEGER NOT NULL,
--     modelType TEXT NOT NULL,
--     content TEXT NOT NULL -- Ids of the list items so we can fetch them from the contentDataTable based on the modelType
-- );
--
-- CREATE TABLE contentData (
--     modelId INTEGER,
--     modelType TEXT,
--     modelVersion INTEGER,
--     content TEXT,
--     apiUrl TEXT UNIQUE ON CONFLICT REPLACE, -- In case of modelType cannot be determined and also the modelId so we will fetch using the apiUrl
--     PRIMARY KEY (modelId, modelType) ON CONFLICT REPLACE
-- );
--
-- -- -- Get list data by model version and API url
-- getListDataByModelVersionAndApiUrl:
-- SELECT * FROM listData WHERE modelVersion = ? AND apiUrl = ?;
--
-- -- -- Get list data by Model version and model type
-- getListDataByModelVersionAndModelType:
-- SELECT * FROM listData WHERE modelVersion = ? AND modelType = ?;
--
-- -- -- Get list data by API url
-- getListDataByApiUrl:
-- SELECT * FROM listData WHERE apiUrl = ?;
--
-- -- -- Get list data by model type
-- getListDataByModelType:
-- SELECT * FROM listData WHERE modelType = ?;
--
-- -- -- Insert or update list data
-- insertOrUpdateListData:
-- INSERT OR REPLACE INTO listData (apiUrl, modelVersion, modelType, content) VALUES (?, ?, ?, ?);
--
-- -- -- Delete list data by model version and API url
-- deleteListDataByModelVersionAndApiUrl:
-- DELETE FROM listData WHERE modelVersion = ? AND apiUrl = ?;
--
-- -- -- Delete list data by API url
-- deleteListDataByApiUrl:
-- DELETE FROM listData WHERE apiUrl = ?;
