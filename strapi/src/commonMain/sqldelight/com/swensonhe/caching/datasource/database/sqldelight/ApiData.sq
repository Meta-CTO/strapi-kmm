-- SELECT * FROM contentData WHERE modelVersion = ? AND apiUrl = ?;
--
-- -- -- Get content data by model type
-- getContentDataByModelType:
-- SELECT * FROM contentData WHERE modelType = ?;
--
-- -- -- Get content data by API url
-- getContentDataByApiUrl:
-- SELECT * FROM contentData WHERE apiUrl = ?;
--
-- -- -- Insert or update content data
-- insertOrUpdateContentData:
-- INSERT OR REPLACE INTO contentData (modelId, modelType, modelVersion, content, apiUrl) VALUES (?, ?, ?, ?, ?);
--
-- -- -- Delete content data by model version and model type
-- deleteContentDataByModelVersionAndModelType:
-- DELETE FROM contentData WHERE modelVersion = ? AND modelType = ?;
--
-- -- -- Delete content data by model version and API url
-- deleteContentDataByModelVersionAndApiUrl:
-- DELETE FROM contentData WHERE modelVersion = ? AND apiUrl = ?;
--
-- -- -- Delete content data by model type
-- deleteContentDataByModelType:
-- DELETE FROM contentData WHERE modelType = ?;
